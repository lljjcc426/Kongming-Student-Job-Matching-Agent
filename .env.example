ARK_BASE_URL=https://ai.gitee.com/v1
ARK_API_KEY=your_gitee_ai_access_token
ARK_PACKAGE=1492
ARK_MODEL=Qwen3-4B
ARK_VISION_MODEL=Qwen3-VL-8B-Instruct
ARK_REQUEST_TIMEOUT_MS=90000

# Static/HarmonyOS builds call a public HTTPS server-side proxy. Never put ARK_API_KEY in VITE_* variables.
VITE_ARK_API_URL=https://your-deployment.example/api/ark

# Public job collection API used by the HarmonyOS file-based build.
VITE_JOBS_API_URL=https://your-deployment.example/api/jobs
VITE_HEALTH_API_URL=https://your-deployment.example/api/health

# Optional JSON snapshot for local or long-running server deployments. Leave empty on Vercel.
JOB_STORE_PATH=E:\KongMing-Job-Matching-Agent\.runtime\jobs.json

# Optional extra ATS sources. Example fields: id, company, adapter, boardToken/site/boardName/orgId.
JOB_SOURCE_CONFIG_JSON=[]
