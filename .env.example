# Server-side model configuration. Use your own credentials.
# OpenAI / Claude / Ollama / custom endpoints: docs/configuration.md
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_TEXT_MODEL=gpt-4.1-mini
MODEL_VISION_MODEL=gpt-4.1-mini
# MODEL_REQUEST_TIMEOUT_MS=65000
# MODEL_MAX_OUTPUT_TOKENS=8000

# Optional OCR. "local" requires the Python dependencies in
# scripts/ocr-requirements.txt; see docs/12-ocr-integration.md.
OCR_PROVIDER=local
# OCR_PYTHON_PATH=/absolute/path/to/ocr-env/bin/python
# OCR_MODEL_CACHE=/absolute/path/to/ocr-cache
# VOLC_OCR_ACCESS_KEY=
# VOLC_OCR_SECRET_KEY=

# Optional local job knowledge base. Use absolute paths.
# JOB_RAG_PYTHON_PATH=/absolute/path/to/rag-env/bin/python
# JOB_RAG_DATA_PATH=/absolute/path/to/jobs-500.jsonl
# JOB_RAG_INDEX_ROOT=/absolute/path/to/index
# JOB_RAG_QDRANT_PATH=/absolute/path/to/database/qdrant
# HF_HOME=/absolute/path/to/huggingface

# Set true only when browsing the UI without a local knowledge base.
# JOB_RAG_SKIP_WARMUP=true
