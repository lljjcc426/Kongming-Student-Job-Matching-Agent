ARK_BASE_URL=https://ai.gitee.com/v1
ARK_API_KEY=your_gitee_ai_access_token
ARK_PACKAGE=1492
ARK_MODEL=Qwen3-4B
ARK_VISION_MODEL=Qwen3-VL-8B-Instruct
ARK_REQUEST_TIMEOUT_MS=90000

# iFLYTEK Spark. Set AI_MODEL_PROVIDER=iflytek-spark and choose one server-side authentication mode.
AI_MODEL_PROVIDER=iflytek-spark
# Mode 1: OpenAI-compatible API.
IFLYTEK_SPARK_API_PASSWORD=your_iflytek_spark_api_password
IFLYTEK_SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
# Mode 2: native WebSocket HMAC API. Leave APIPassword empty when using this mode.
IFLYTEK_SPARK_APP_ID=your_iflytek_app_id
IFLYTEK_SPARK_API_KEY=your_iflytek_api_key
IFLYTEK_SPARK_API_SECRET=your_iflytek_api_secret
# Optional override. The default WebSocket URL is selected from IFLYTEK_SPARK_MODEL.
IFLYTEK_SPARK_WS_URL=
IFLYTEK_SPARK_MODEL=4.0Ultra
# Optional. Leave empty unless the selected Spark account exposes a compatible vision model.
IFLYTEK_SPARK_VISION_MODEL=
IFLYTEK_SPARK_REQUEST_TIMEOUT_MS=65000

# Web uses the same-origin /api/gateway route. List only additional trusted browser origins here.
# Native HarmonyOS requests do not send an Origin header and use the gateway URL injected at HAP build time.
PUBLIC_APP_ORIGINS=https://your-frontend.example

# Optional JSON snapshot for local or long-running server deployments. Leave empty on Vercel.
JOB_STORE_PATH=D:\KongMing-Job-Matching-Agent\.runtime\jobs.json

# Optional extra ATS sources. Example fields: id, company, adapter, boardToken/site/boardName/orgId.
JOB_SOURCE_CONFIG_JSON=[]
