{
  "envId": "kongming-career-demo-d2a6ec63160",
  "version": "2.0",
  "framework": {
    "name": "kongming-student-job-matching-agent",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "dist",
          "cloudPath": "/"
        }
      }
    }
  },
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "ark",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "memorySize": 512,
      "installDependency": true
    }
  ]
}
