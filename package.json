{
  "name": "kongming-student-job-matching-agent",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:web:harmony": "tsc -b && vite build --base ./",
    "sync:harmony:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-harmony-web.ps1",
    "build:harmony": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-harmony.ps1",
    "build:harmony:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-harmony.ps1 -RequireOnlineServices",
    "build:harmony:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-harmony.ps1 -LocalDevApiBaseUrl http://127.0.0.1:5173",
    "run:harmony:emulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-harmony-emulator.ps1",
    "preview": "vite preview --host 0.0.0.0",
    "verify:parsers": "node scripts/verify-parsers.cjs",
    "verify:evidence": "node scripts/verify-evidence-architecture.cjs",
    "verify:claims": "node scripts/verify-release-claims.cjs",
    "verify:jobs": "node scripts/verify-job-collector.cjs",
    "verify:job-sources": "node scripts/verify-job-sources.cjs",
    "verify:harmony": "node scripts/verify-harmony-project.cjs",
    "verify:ui": "node scripts/verify-ui.cjs",
    "verify:core": "npm run verify:parsers && npm run verify:evidence && npm run verify:jobs && npm run verify:job-sources && npm run verify:harmony && npm run verify:claims"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@hazart-pkg/live2d-core": "^1.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vitejs/plugin-react": "^5.1.1",
    "animejs": "^4.4.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.561.0",
    "pdfjs-dist": "^6.0.227",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3"
  }
}
